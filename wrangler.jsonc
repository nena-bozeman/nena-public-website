{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nena-public-website",
  "compatibility_date": "2026-05-07",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "nenabozeman.org",
      "custom_domain": true
    }
  ]
}
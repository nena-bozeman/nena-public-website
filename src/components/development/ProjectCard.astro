---
import { Image } from 'astro:assets';
import {
  DEVELOPMENT_PHASE_BADGE,
  type DevelopmentPhase,
} from '../../schemas/development-phase';
import { getDevelopmentImage } from '../../utils/development-image';

export interface Props {
  slug: string;
  title: string;
  phase: DevelopmentPhase;
  address: string;
  developer?: string;
  summary: string;
  dateUpdated: Date;
  cityPlanningUrl?: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}

const base = import.meta.env.BASE_URL;
const {
  slug,
  title,
  phase,
  address,
  developer,
  summary,
  dateUpdated,
  cityPlanningUrl,
  tags = [],
  image,
  imageAlt = '',
} = Astro.props;
const projectHref = `${base}development/${slug}`;
const badge = DEVELOPMENT_PHASE_BADGE[phase];
const photo = getDevelopmentImage(image);
const thumbWidth = photo ? Math.min(photo.width, 800) : undefined;
const thumbHeight =
  photo && thumbWidth ? Math.round((thumbWidth / photo.width) * photo.height) : undefined;
---

<article class="bg-white rounded-lg shadow-xs hover:shadow-md transition-shadow border border-gray-100 p-6">
  {photo && thumbWidth && thumbHeight && (
    <a href={projectHref} class="mb-4 -mx-6 -mt-6 block overflow-hidden rounded-t-lg">
      <Image
        src={photo}
        alt={imageAlt}
        class="h-40 w-full object-cover"
        width={thumbWidth}
        height={thumbHeight}
        sizes="(max-width: 768px) 100vw, 24rem"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <div class="flex items-center gap-2 mb-2">
    <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${badge.color}`}>
      {badge.label}
    </span>
  </div>
  <h3 class="font-serif font-bold text-primary text-lg mb-1">
    <a href={projectHref} class="hover:text-accent transition-colors">{title}</a>
  </h3>
  <p class="text-sm text-gray-500 mb-1">📍 {address}</p>
  {developer && <p class="text-sm text-gray-500 mb-2">Developer: {developer}</p>}
  <p class="text-gray-600 text-sm leading-relaxed mb-3">{summary}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-3">
      {tags.map((tag) => (
        <span class="text-xs bg-gray-50 text-gray-600 px-2 py-0.5 rounded-full border">{tag}</span>
      ))}
    </div>
  )}
  <div class="flex flex-col gap-2 mt-3 pt-3 border-t border-gray-50 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-xs text-gray-400">Updated {dateUpdated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={projectHref} class="text-accent hover:text-amber-700 text-xs font-medium transition-colors">Project details →</a>
      {cityPlanningUrl && (
        <a href={cityPlanningUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-amber-700 text-xs font-medium transition-colors">
          City Planning Docs →
        </a>
      )}
    </div>
  </div>
</article>

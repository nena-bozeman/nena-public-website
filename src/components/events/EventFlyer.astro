---
interface Props {
  href: string;
  src: string;
  alt: string;
}

const { href, src, alt } = Astro.props;
const base = import.meta.env.BASE_URL;

function publicAsset(path: string): string {
  if (/^https?:\/\//.test(path)) return path;
  return `${base}${path.replace(/^\//, '')}`;
}
---

<a href={publicAsset(href)} class="float-right mb-4 ml-4 w-32 no-underline sm:ml-6 sm:w-44">
  <img
    src={publicAsset(src)}
    alt={alt}
    width="850"
    height="1100"
    class="h-auto w-full rounded-lg border border-gray-200 bg-white shadow-xs"
  />
  <span class="mt-2 block text-center text-sm font-medium text-accent">Full flyer (PDF)</span>
</a>

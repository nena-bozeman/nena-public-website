---
import { getMailchimpSignupUrl } from '../../../utils/mailchimp';

const base = import.meta.env.BASE_URL;
const mailchimpUrl = getMailchimpSignupUrl();
---

<section class="bg-cream rounded-lg p-8 border border-amber-100 not-prose">
  <h2 class="font-serif text-2xl font-bold text-primary mb-4">Contact Us</h2>
  <div class="space-y-2 text-gray-700">
    <p>
      📧{' '}
      <a href="mailto:NENABozeman@gmail.com" class="text-accent hover:text-amber-700 font-medium">NENABozeman@gmail.com</a>
    </p>
    <p>
      For updates and ways to participate, see the{' '}
      <a href={`${base}contact`} class="text-accent hover:text-amber-700 font-medium">Contact</a>
      {' '}page, the{' '}
      <a href={`${base}newsletter`} class="text-accent hover:text-amber-700 font-medium">newsletter</a>
      {' '}page, and the{' '}
      <a href={`${base}events`} class="text-accent hover:text-amber-700 font-medium">Events</a>
      {' '}calendar.
    </p>
    <p class="pt-2">
      <a
        href={mailchimpUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-accent hover:bg-amber-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        Subscribe to newsletter
      </a>
    </p>
  </div>
</section>

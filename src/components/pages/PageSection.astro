---
import BoardOfficers from './sections/BoardOfficers.astro';
import NeighborhoodMap from './sections/NeighborhoodMap.astro';
import ContactCta from './sections/ContactCta.astro';
import ContactDetails from './sections/ContactDetails.astro';
import NewsletterCta from './sections/NewsletterCta.astro';
import DonateForm from './sections/DonateForm.astro';
import ArtsBusinessList from './sections/ArtsBusinessList.astro';

const { name, pageSlug } = Astro.props;

const boardVariant = pageSlug === 'about' ? 'about' : 'governance';
---

{name === 'neighborhood-map' && <NeighborhoodMap />}
{name === 'board-officers' && <BoardOfficers variant={boardVariant} />}
{name === 'contact-cta' && <ContactCta />}
{name === 'contact-details' && <ContactDetails />}
{name === 'newsletter-cta' && <NewsletterCta />}
{name === 'donate-form' && <DonateForm />}
{name === 'arts-business-list' && <ArtsBusinessList />}

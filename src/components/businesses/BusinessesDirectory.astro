---
import Base from '../../layouts/Base.astro';
import ListStatusLegacyRedirect from '../filters/ListStatusLegacyRedirect.astro';
import PlaceTypeFilters from '../filters/PlaceTypeFilters.astro';
import PlacesArchiveNav from '../places/PlacesArchiveNav.astro';
import BusinessList from './BusinessList.astro';
import BusinessMap from './BusinessMap.astro';
import { getCollection } from 'astro:content';
import { placeBusinessCategoryFilterOptions, type PlaceType } from '../../utils/place-categories';
import { listStatusHref, matchesListStatus, type ListStatus } from '../../utils/list-status';

export interface Props {
  filterStatus: ListStatus;
  layout?: 'grid' | 'table';
}

const { filterStatus, layout = 'grid' } = Astro.props;
const base = import.meta.env.BASE_URL;
const cardsHref = listStatusHref('places', filterStatus, base);
const tableHref = listStatusHref('places', filterStatus, base, 'table');
const viewBtnActive =
  'px-4 py-2 rounded-sm text-sm font-medium bg-primary text-white transition-colors';
const viewBtnIdle =
  'px-4 py-2 rounded-sm text-sm font-medium bg-white text-gray-600 border border-gray-200 hover:border-primary transition-colors';
const allBusinesses = await getCollection('places');
const filtered = allBusinesses.filter((b) => matchesListStatus(b.data.status, filterStatus));
const businesses =
  filterStatus === 'past'
    ? [...filtered].sort((a, b) => {
        const ya = a.data.closedYear ?? 0;
        const yb = b.data.closedYear ?? 0;
        if (yb !== ya) return yb - ya;
        return a.data.name.localeCompare(b.data.name);
      })
    : filtered;

const pageTitle = filterStatus === 'past' ? 'Past Places' : 'Places';
const pageDescription =
  filterStatus === 'past'
    ? 'Former Northeast Neighborhood businesses and other places kept on record for neighborhood history.'
    : 'Businesses, parks, and landmarks in the Northeast Neighborhood of Bozeman, Montana';

const categories = placeBusinessCategoryFilterOptions(businesses);
const hasBusinessListings = businesses.some((b) => b.data.placeType === 'business');
const showCategoryFilters = hasBusinessListings && categories.length > 1;
const placeTypesPresent = [
  ...new Set(businesses.map((b) => b.data.placeType)),
] as PlaceType[];
---

<Base title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 mb-10 items-start">
      <div>
        <h1 class="font-serif text-4xl font-bold text-primary mb-4">{pageTitle}</h1>
        {
          filterStatus === 'past' ? (
            <p class="text-gray-600 mb-6 max-w-2xl">
              Listings for businesses that have closed remain here for reference. Year shown is when they
              closed, when known.
            </p>
          ) : (
            <p class="text-gray-600 mb-6">
              Supporting local businesses, parks, and landmarks in the Northeast Neighborhood.
            </p>
          )
        }

        <PlaceTypeFilters availableTypes={placeTypesPresent} />
        {
          showCategoryFilters && (
            <div id="category-filters-section" class="mt-4">
              <p class="text-sm font-medium text-gray-700 mb-2" id="category-filter-label">
                Business category
              </p>
              <div
                class="flex flex-wrap gap-2"
                id="category-filters"
                role="group"
                aria-labelledby="category-filter-label"
              >
                {categories.map((cat) => (
                  <button
                    type="button"
                    data-category={cat.value === '' ? 'all' : cat.value}
                    class={`px-3 py-1 rounded-full text-sm font-medium transition-colors category-filter ${cat.value === '' ? 'bg-primary text-white' : 'bg-white text-gray-600 border border-gray-200 hover:border-primary'}`}
                  >
                    {cat.label}
                  </button>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="lg:sticky lg:top-4">
        <BusinessMap businesses={businesses} compact />
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-sm text-gray-600">View</span>
      <a
        href={cardsHref}
        class:list={[layout === 'grid' ? viewBtnActive : viewBtnIdle]}
        aria-current={layout === 'grid' ? 'page' : undefined}
      >
        Cards
      </a>
      <a
        href={tableHref}
        class:list={[layout === 'table' ? viewBtnActive : viewBtnIdle]}
        aria-current={layout === 'table' ? 'page' : undefined}
      >
        Table
      </a>
    </div>

    <BusinessList businesses={businesses} layout={layout} />
    <PlacesArchiveNav
      filterStatus={filterStatus}
      extraSegment={layout === 'table' ? 'table' : undefined}
    />
    {filterStatus === 'current' && <ListStatusLegacyRedirect pagePath="places" />}
  </div>
</Base>

<script>
  function parseBusinessCategories(el: HTMLElement): string[] {
    return (el.getAttribute('data-categories') ?? '')
      .split(',')
      .map((c) => c.trim())
      .filter(Boolean);
  }

  function getActivePlaceType(): string {
    const el = document.querySelector<HTMLButtonElement>(
      '.place-type-filter.place-type-filter-active',
    );
    const placeType = el?.getAttribute('data-place-type') ?? 'all';
    return placeType === 'all' ? '' : placeType;
  }

  function getActiveCategory(): string {
    const el = document.querySelector<HTMLButtonElement>(
      '#category-filters button.category-filter.bg-primary',
    );
    const cat = el?.getAttribute('data-category') ?? 'all';
    return cat === 'all' ? '' : cat;
  }

  function showsBusinessCategories(placeType: string): boolean {
    return !placeType || placeType === 'business';
  }

  function resetCategoryToAll() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter');
    filterBtns.forEach((b) => {
      b.classList.remove('bg-primary', 'text-white');
      b.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
    });
    const allBtn = document.querySelector<HTMLButtonElement>(
      '#category-filters button.category-filter[data-category="all"]',
    );
    allBtn?.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');
    allBtn?.classList.add('bg-primary', 'text-white');
  }

  function updateCategoryVisibility(placeType: string) {
    const section = document.getElementById('category-filters-section');
    if (!section) return;
    const show = showsBusinessCategories(placeType);
    section.classList.toggle('hidden', !show);
    if (!show) resetCategoryToAll();
  }

  function applyPlaceFilters() {
    const placeType = getActivePlaceType();
    updateCategoryVisibility(placeType);
    const category = showsBusinessCategories(placeType) ? getActiveCategory() : '';
    const items = document.querySelectorAll<HTMLElement>('.business-list-item[data-place-type]');
    const tableWrap = document.getElementById('business-list-table-wrap');
    const grid = document.getElementById('business-list-grid');
    const emptyMsg = document.getElementById('business-category-empty');
    let visible = 0;

    items.forEach((el) => {
      const cats = parseBusinessCategories(el);
      const type = el.getAttribute('data-place-type') ?? '';
      const showType = !placeType || type === placeType;
      const showCategory = !category || cats.includes(category);
      const show = showType && showCategory;
      el.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });

    const hideList = visible === 0 && items.length > 0;
    if (tableWrap) tableWrap.classList.toggle('hidden', hideList);
    if (grid) grid.classList.toggle('hidden', hideList);
    emptyMsg?.classList.toggle('hidden', visible > 0 || items.length === 0);
  }

  function applyBusinessCategoryFilter(_category: string) {
    applyPlaceFilters();
    window.dispatchEvent(
      new CustomEvent('nena-businesses-filter', {
        detail: { category: getActiveCategory(), placeType: getActivePlaceType() },
      }),
    );
  }

  const typeFilterBtns = document.querySelectorAll<HTMLButtonElement>('.place-type-filter');
  const typeTabBase =
    'place-type-filter rounded-md px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
  const typeTabIdle = `${typeTabBase} text-gray-600 hover:text-primary`;
  const typeTabSelected = `${typeTabBase} place-type-filter-active bg-white text-primary shadow-xs`;

  typeFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeFilterBtns.forEach((b) => {
        b.className = typeTabIdle;
        b.classList.remove('place-type-filter-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.className = typeTabSelected;
      btn.classList.add('place-type-filter-active');
      btn.setAttribute('aria-selected', 'true');
      applyPlaceFilters();
      window.dispatchEvent(
        new CustomEvent('nena-businesses-filter', {
          detail: { category: getActiveCategory(), placeType: getActivePlaceType() },
        }),
      );
    });
  });

  applyPlaceFilters();

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-primary', 'text-white');
        b.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      });
      btn.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      btn.classList.add('bg-primary', 'text-white');

      applyBusinessCategoryFilter(btn.getAttribute('data-category') ?? 'all');
    });
  });
</script>


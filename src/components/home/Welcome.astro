---
const base = import.meta.env.BASE_URL;
const yearsOfCommunity = new Date().getFullYear() - 2001;

const pillars = [
  {
    title: 'Community and social connection',
    body: 'Spring and fall meetings, potlucks, and the annual Parade of Sheds bring neighbors together. Walks, cleanups, and other gatherings are posted as they are scheduled.',
    links: [
      { label: 'Parade of Sheds', href: `${base}our-work/parade-of-sheds` },
      { label: 'Meetings', href: `${base}our-work/nena-meetings` },
      { label: 'Events', href: `${base}events` },
    ],
  },
  {
    title: 'Civic advocacy and neighborhood voice',
    body: 'NENA follows planning, development, and day-to-day livability with the City of Bozeman, and keeps neighbors posted.',
    links: [
      { label: 'Neighborhood advocacy', href: `${base}our-work/neighborhood-advocacy` },
      { label: 'Development Watch', href: `${base}development` },
      { label: 'News', href: `${base}news` },
    ],
  },
  {
    title: 'Historic and cultural stewardship',
    body: 'Neighborhood history, local workshops and gathering places, and care for trees, trails, and Bozeman Creek.',
    links: [
      { label: 'Neighborhood history', href: `${base}history` },
      { label: 'Places', href: `${base}places` },
      { label: 'Trails and parks', href: `${base}our-work/trails-pocket-parks` },
    ],
  },
];
---

<section class="bg-cream py-16 px-4 border-b border-amber-100">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="font-serif text-3xl font-bold text-primary mb-6">Welcome to the Northeast Neighborhood</h2>
    <p class="text-xl text-gray-700 leading-relaxed">
      Whether you rent, own, work, run a local business, just moved in or have lived in the neighborhood for decades, you belong here.
    </p>
    <p class="mt-4 text-lg text-gray-700 leading-relaxed">
      NENA is a grassroots, volunteer-run neighborhood association, not a homeowners association. Neighbors who care about this part of Bozeman take an active role so that it continues to be a unique place where people want to live, work, visit, and patronize.
    </p>
    <div class="mt-8 flex flex-wrap gap-6 justify-center text-center">
      <div class="flex flex-col items-center">
        <span class="text-4xl font-serif font-bold text-accent">{yearsOfCommunity}+</span>
        <span class="text-sm text-gray-600 mt-1">Years of Community</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-4xl font-serif font-bold text-accent">500+</span>
        <span class="text-sm text-gray-600 mt-1">Households</span>
      </div>
      <a
        href={`${base}our-work`}
        class="flex flex-col items-center transition-opacity hover:opacity-80"
      >
        <span class="text-4xl font-serif font-bold text-accent">Many</span>
        <span class="text-sm text-gray-600 mt-1">Active Programs</span>
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto mt-16">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl font-bold text-primary">What we do</h2>
        <p class="text-gray-600 mt-2">Three areas of neighborhood work. The About page tells the fuller story.</p>
      </div>
      <a href={`${base}about`} class="text-accent hover:text-amber-700 font-medium transition-colors shrink-0">
        About NENA →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <article class="bg-white rounded-lg shadow-xs border border-amber-100 p-6">
          <h3 class="font-serif text-xl font-bold text-primary mb-3">{pillar.title}</h3>
          <p class="text-gray-700 leading-relaxed">{pillar.body}</p>
          <ul class="mt-4 space-y-1">
            {pillar.links.map((link) => (
              <li>
                <a href={link.href} class="text-accent hover:text-amber-700 text-sm font-medium transition-colors">
                  {link.label} →
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
